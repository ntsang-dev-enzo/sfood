>
<!ELEMENT name (#PCDATA)>
<!ELEMENT price (#PCDATA)>
<!ELEMENT unit (#PCDATA)>
<!ELEMENT calories (#PCDATA)>
<!ELEMENT description (#PCDATA)>
<!ELEMENT origin (#PCDATA)>
<!ELEMENT preparation_time (#PCDATA)>
<!ELEMENT image (#PCDATA)>

